# Backend environment template for local development
# Copy this file to .env and replace values where needed.

DATABASE_URL=postgresql://gigshield:gigshield123@localhost:5432/gigshield
REDIS_URL=redis://localhost:6379

# Use a long random value in real deployments
SECRET_KEY=replace-with-a-long-random-secret

# Razorpay (mock values are fine for demo mode)
RAZORPAY_KEY_ID=mock_key_id
RAZORPAY_KEY_SECRET=mock_key_secret
RAZORPAY_FUND_ACCOUNT=mock_fund_account

# Runtime
ENVIRONMENT=development
DEBUG=true

# Comma-separated E.164 numbers allowed to access admin routes
# Example: +919876543210,+911234567890
ADMIN_PHONES=
